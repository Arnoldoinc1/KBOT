# development is suitable for local START_ALL.bat; use .env.production.example for deployment.
KBOT_ENV=development

# Shared application database. SQLite works for local/testing; MySQL is recommended for deployment.
APP_SECRET_KEY=SET_YOUR_OWN_RANDOM_VALUE
DATABASE_URL=sqlite:///data/shared/kbot.db

# Independent Knowledge Service
KNOWLEDGE_SERVICE_URL=http://127.0.0.1:5100
KNOWLEDGE_ADMIN_KEY=SET_YOUR_OWN_RANDOM_VALUE
KNOWLEDGE_READ_KEY=SET_YOUR_OWN_RANDOM_VALUE
KNOWLEDGE_DATA_DIR=data/knowledge
KNOWLEDGE_TIMEOUT=15
MAX_UPLOAD_SIZE_MB=50
KNOWLEDGE_EMBEDDING_MODEL_PATH=models/bge-base-en-v1.5
KNOWLEDGE_CHROMA_ENABLED=true
KNOWLEDGE_CHROMA_PATH=data/knowledge/chroma
KNOWLEDGE_CHROMA_COLLECTION=course_chunks
KNOWLEDGE_CHROMA_TOP_K=80
KNOWLEDGE_DENSE_SEARCH_WEIGHT=0.35

# Three Coze Agents share the API base and token by default.
# true = call Coze; false = local fallbacks only; auto = enable only when a root .env exists.
COZE_ENABLED=true
COZE_API_BASE=https://api.coze.com
COZE_TOKEN=
COZE_QUIZ_BOT_ID=
COZE_GRADING_BOT_ID=
COZE_NOTES_BOT_ID=
# Recommended production routing: Coze writes the language-heavy MCQ and
# Short Answer items; deterministic grounded constructors handle True/False,
# Matching, and Fill Blank. Every Agent failure has a local recovery path.
COZE_QUIZ_TYPES=mcq,short_answer
COZE_TIMEOUT=25
COZE_QUIZ_TIMEOUT=25
COZE_GRADING_TIMEOUT=30
COZE_NOTES_TIMEOUT=30
COZE_CIRCUIT_FAILURES=3
COZE_CIRCUIT_COOLDOWN=60
COZE_STREAM_ENABLED=true
GENERATION_LOCK_TTL=90

# Optional per-Agent tokens; leave empty to use COZE_TOKEN.
COZE_QUIZ_TOKEN=
COZE_GRADING_TOKEN=
COZE_NOTES_TOKEN=


# Teacher record search and Knowledge RAG both use local optional Chroma
# embeddings. Install requirements-semantic.txt and place
# BAAI/bge-base-en-v1.5 at the local model path; the servers never download a
# model during a request.
TEACHER_SEARCH_MAX_RECORDS=5000
TEACHER_SEARCH_RESULT_LIMIT=100
TEACHER_SEMANTIC_MODEL_PATH=models/bge-base-en-v1.5
TEACHER_CHROMA_ENABLED=true
TEACHER_CHROMA_PATH=data/teacher/chroma
TEACHER_CHROMA_COLLECTION=student_qa_records
TEACHER_CHROMA_TOP_K=50
TEACHER_DENSE_SEARCH_WEIGHT=0.35

# Service listeners
TEACHER_HOST=127.0.0.1
TEACHER_PORT=5000
STUDENT_HOST=127.0.0.1
STUDENT_PORT=8000
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=5100

# Browser session security. HTTPS deployments should use the production template.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# Optional separate cookie secrets; leave empty to inherit APP_SECRET_KEY.
TEACHER_SECRET_KEY=
STUDENT_SECRET_KEY=

# Backward-compatible local teacher account used by the original teacher UI.
# Change or disable this before deployment.
SEED_DEMO_TEACHER=false
DEMO_TEACHER_USERNAME=teacher1
DEMO_TEACHER_PASSWORD=

# Docker Compose MySQL values (used only by docker-compose.yml).
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=edu_qa


# Legacy account/data compatibility. The default Docker volume name reuses the
# original v6.2 MySQL volume so existing teacher/student accounts remain visible.
MYSQL_VOLUME_NAME=edu_qa_mysql_data
KNOWLEDGE_VOLUME_NAME=kbot_knowledge_data
DEMO_USER=rukizhao
DEMO_PASS=zhaoruoqi
ALLOW_TEACHER_REGISTRATION=true
LEGACY_TEACHER_COMPAT=true
