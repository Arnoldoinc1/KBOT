# Copy to .env only for a real deployment. Replace every CHANGE_ME value.
KBOT_ENV=production
APP_SECRET_KEY=CHANGE_ME_USE_AT_LEAST_32_RANDOM_CHARACTERS
DATABASE_URL=mysql+pymysql://kbot_user:CHANGE_ME_DB_PASSWORD@127.0.0.1:3307/edu_qa?charset=utf8mb4

KNOWLEDGE_SERVICE_URL=http://127.0.0.1:5100
KNOWLEDGE_ADMIN_KEY=CHANGE_ME_PRIVATE_ADMIN_KEY
KNOWLEDGE_READ_KEY=CHANGE_ME_PRIVATE_READ_KEY
KNOWLEDGE_DATA_DIR=data/knowledge
KNOWLEDGE_TIMEOUT=15
MAX_UPLOAD_SIZE_MB=50
KNOWLEDGE_EMBEDDING_MODEL_PATH=models/bge-base-en-v1.5
KNOWLEDGE_CHROMA_ENABLED=true
KNOWLEDGE_CHROMA_PATH=data/knowledge/chroma
KNOWLEDGE_CHROMA_COLLECTION=course_chunks
KNOWLEDGE_CHROMA_TOP_K=80
KNOWLEDGE_DENSE_SEARCH_WEIGHT=0.35

COZE_ENABLED=true
COZE_API_BASE=https://api.coze.com
COZE_TOKEN=CHANGE_ME_COZE_TOKEN
COZE_QUIZ_BOT_ID=CHANGE_ME_QUIZ_BOT_ID
COZE_GRADING_BOT_ID=CHANGE_ME_GRADING_BOT_ID
COZE_NOTES_BOT_ID=CHANGE_ME_NOTES_BOT_ID
COZE_QUIZ_TYPES=mcq,short_answer
COZE_TIMEOUT=25
COZE_QUIZ_TIMEOUT=25
COZE_GRADING_TIMEOUT=30
COZE_NOTES_TIMEOUT=30
COZE_CIRCUIT_FAILURES=3
COZE_CIRCUIT_COOLDOWN=60
COZE_STREAM_ENABLED=true
GENERATION_LOCK_TTL=90

# Optional separate Agent tokens.
COZE_QUIZ_TOKEN=
COZE_GRADING_TOKEN=
COZE_NOTES_TOKEN=

# Teacher record search and Knowledge RAG both use local optional Chroma
# embeddings. Install requirements-semantic.txt and place
# BAAI/bge-base-en-v1.5 at a LOCAL model path.
TEACHER_SEARCH_MAX_RECORDS=5000
TEACHER_SEARCH_RESULT_LIMIT=100
TEACHER_SEMANTIC_MODEL_PATH=models/bge-base-en-v1.5
TEACHER_CHROMA_ENABLED=true
TEACHER_CHROMA_PATH=data/teacher/chroma
TEACHER_CHROMA_COLLECTION=student_qa_records
TEACHER_CHROMA_TOP_K=50
TEACHER_DENSE_SEARCH_WEIGHT=0.35

TEACHER_HOST=127.0.0.1
TEACHER_PORT=5000
STUDENT_HOST=127.0.0.1
STUDENT_PORT=8000
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=5100
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=Lax

TEACHER_SECRET_KEY=
STUDENT_SECRET_KEY=
SEED_DEMO_TEACHER=false
ALLOW_TEACHER_REGISTRATION=false
LEGACY_TEACHER_COMPAT=false
DEMO_TEACHER_USERNAME=
DEMO_TEACHER_PASSWORD=
DEMO_USER=
DEMO_PASS=

# Docker Compose values.
MYSQL_ROOT_PASSWORD=CHANGE_ME_MYSQL_ROOT_PASSWORD
MYSQL_DATABASE=edu_qa
MYSQL_VOLUME_NAME=edu_qa_mysql_data
KNOWLEDGE_VOLUME_NAME=kbot_knowledge_data
